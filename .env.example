# 复制为 .env.local 后填写。.env.local 不要提交到代码库。

# SQLite 数据文件所在目录，默认是项目下的 data/
DATA_DIR=

# 留言邮件通知（SMTP）。163 邮箱需在网页端开启 SMTP 服务，SMTP_PASS 填“授权码”而不是登录密码。
# 不填 SMTP_PASS 时留言仍会保存到数据库，只是不发邮件。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=changjielisheng@163.com
SMTP_PASS=
# 收件邮箱，默认同 data/site.json 里的 email
MAIL_TO=changjielisheng@163.com

# 后台 /admin 的登录账号。两项都填写后台才启用。
ADMIN_USER=
ADMIN_PASSWORD=

# 网站前面有 Nginx 等反向代理时设为 1，采用代理写入的 X-Forwarded-For 作为访客 IP。
# 代理需配置：proxy_set_header X-Forwarded-For $remote_addr;
# 不设置时使用真实连接地址（适用于 Node 直接对外提供服务）。
TRUST_PROXY=

# 监听端口，默认 4173
PORT=
